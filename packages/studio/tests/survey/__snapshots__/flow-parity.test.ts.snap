exports[`flow-parity: identity_lite — questions[] > projected fields are stable (snapshot) > identity_lite questions projected 1`] = `
[
  {
    "help_text": "Start typing your language's English name and pick it from the list (for example: Hausa, Swahili, Hindi). When two languages share a name, the list shows the region and local name so you can choose the right one. If your language is not listed, just type its English name and continue — free text is always accepted.",
    "id": "il_language_english",
    "next": [
      {
        "condition": "ctx.ilRegionAmbiguous == 'true'",
        "goto": "il_language_region",
      },
      {
        "default": true,
        "goto": "il_language_autonym",
      },
    ],
    "options": undefined,
    "options_source": "@langtags_names",
    "prompt": "What is your language called in English?",
    "required": true,
    "type": "autocomplete",
  },
  {
    "help_text": "This language is used in more than one place, and the local name or spelling can differ by region. Pick the region that matches your community — or skip if you are unsure.",
    "id": "il_language_region",
    "next": "il_language_autonym",
    "options": undefined,
    "options_source": undefined,
    "prompt": "Which region is your language from?",
    "required": false,
    "type": "autocomplete",
  },
  {
    "help_text": "The name your community uses for the language, in your own spelling and characters. For example: Fà', Kiswahili, हिन्दी. Pick a suggested name or type your own — edit it to match your spelling.",
    "id": "il_language_autonym",
    "next": "il_language_code",
    "options": undefined,
    "options_source": undefined,
    "prompt": "What is your language called in your own language?",
    "required": true,
    "type": "autocomplete",
  },
  {
    "help_text": "This is the standard code for the language you picked — it goes on the finished keyboard. It is filled in from your choice above; change it only if you need a different code, or type one directly if your language was not in the list.",
    "id": "il_language_code",
    "next": "il_target_script",
    "options": undefined,
    "options_source": "@langtags_iso639",
    "prompt": "Confirm your language's code",
    "required": false,
    "type": "autocomplete",
  },
  {
    "help_text": "Choose the writing system this keyboard produces. It can differ from the script your language normally uses: pick "Latin romanization" or "IPA" if you are building a romanized or phonetic keyboard. The script you choose here — not the language — decides the keyboard's layout family.",
    "id": "il_target_script",
    "next": [
      {
        "condition": "value == 'Ethi' or value == 'Hani' or value == 'Hang'",
        "goto": "il_script_not_supported",
      },
      {
        "default": true,
        "goto": "il_author_name",
      },
    ],
    "options": [
      {
        "label": "Latin (A–Z and accented letters like é, ñ, ŋ)",
        "value": "Latn",
      },
      {
        "label": "Latin romanization (the keyboard produces Latin letters A–Z and diacritics)",
        "value": "romanization-Latn",
      },
      {
        "label": "IPA — phonetic transcription (Latin-based)",
        "value": "fonipa",
      },
      {
        "label": "Arabic",
        "value": "Arab",
      },
      {
        "label": "Hebrew",
        "value": "Hebr",
      },
      {
        "label": "Devanagari (Hindi, Nepali, Marathi, and others)",
        "value": "Deva",
      },
      {
        "label": "Cyrillic (Russian, Ukrainian, Serbian, and others)",
        "value": "Cyrl",
      },
      {
        "label": "Greek",
        "value": "Grek",
      },
      {
        "label": "Georgian",
        "value": "Geor",
      },
      {
        "label": "Armenian",
        "value": "Armn",
      },
      {
        "label": "Ethiopic (Ge'ez, Amharic, Tigrinya — not yet supported)",
        "value": "Ethi",
      },
      {
        "label": "Chinese / Japanese Han characters (not yet supported)",
        "value": "Hani",
      },
      {
        "label": "Hangul (Korean — not yet supported)",
        "value": "Hang",
      },
      {
        "label": "Another script not listed here",
        "value": "other",
      },
    ],
    "options_source": undefined,
    "prompt": "Which script will THIS keyboard type?",
    "required": true,
    "type": "select",
  },
  {
    "help_text": "This version does not yet support Ethiopic, Han (Chinese/Japanese), or Hangul keyboards. Hangul needs jamo-to-syllable composition; Ethiopic and Han need reorder / IME candidate work — neither is built yet. You can close this form for now; nothing you entered will be submitted.",
    "id": "il_script_not_supported",
    "next": null,
    "options": undefined,
    "options_source": undefined,
    "prompt": "This writing system is not supported yet",
    "required": false,
    "type": "notice",
  },
  {
    "help_text": "This name will appear in the keyboard package and in the public keyboard repository. You can use a person's name, an organization name, or a committee name, for example: Bafut Language Committee.",
    "id": "il_author_name",
    "next": "il_author_email",
    "options": undefined,
    "options_source": undefined,
    "prompt": "Who should be listed as the author of this keyboard?",
    "required": true,
    "type": "text",
  },
  {
    "help_text": "This address goes into the keyboard package so that users or maintainers can reach the right person if they have questions. Use an address that will remain active.",
    "id": "il_author_email",
    "next": "il_copyright_holder",
    "options": undefined,
    "options_source": undefined,
    "prompt": "What email address can people use to contact the keyboard author?",
    "required": false,
    "type": "text",
  },
  {
    "help_text": "Name of the person or organization that holds the copyright for this keyboard. This may be you, your employer, or a language organization. Example: 'Bafut Language Committee'",
    "id": "il_copyright_holder",
    "next": null,
    "options": undefined,
    "options_source": undefined,
    "prompt": "Who holds the copyright for this keyboard?",
    "required": false,
    "type": "short_text",
  },
]
`;

