  "mechanisms": {
    "deadkeys": "Some characters are typed in two steps. First press a dead key, which types nothing on its own, then press the letter. The typing guide lists each dead key sequence.",
    "rightAlt": "Some characters are on a second layer reached with the right Alt key (AltGr). Hold right Alt and press the key shown in the typing guide.",
    "repeatToCycle": "Some keys type a different character when pressed again. Press the key repeatedly to step through its characters.",
    "combiningOrder": "Accents and other marks are typed after the letter they belong to. Type the base letter first, then the mark."
  },
  "readmePhrases": {
    "languageLine": "For typing {languages} in the {script} script.",
    "languageLineNoScript": "For typing {languages}.",
    "basedOn": "Based on {name}.",
    "basedOnWithLayout": "Based on {name} ({layout} layout).",
    "useCaseLiteracy": "school and literacy materials",
    "useCaseMessaging": "everyday texting and messaging",
    "useCaseOfficial": "official and formal documents",
    "compositionPrecomposed": "Accented letters are produced as single characters.",
    "compositionDecomposed": "Accented letters are produced as a letter followed by a combining mark.",
    "compositionMixed": "Accented letters are produced as single characters where Unicode has one, and otherwise as a letter followed by a combining mark.",
    "fontGeneric": "Some of these characters need a font that supports them. Without one they may show as empty boxes.",
    "removedFrom": "Removed from {name}",
    "noteStartedFrom": "Started from {name}.",
    "noteAdaptedFrom": "Adapted from the previous release of this keyboard.",
    "noteMethods": "{group}: {methods}.",
    "methodRightAlt": "Right Alt",
    "methodSequence": "key sequences",
    "methodTouch": "touch long-press or flick",
    "noteMarksPrefix": "Marks are typed before the letter they belong to.",
    "noteMarksPostfix": "Marks are typed after the letter they belong to.",
    "noteTouchFromDesktop": "The touch layout was generated from the desktop layout.",
    "noteTouchAdapted": "The touch layout was adapted from {name}.",
    "noteRemovedSwallow": "{count} characters of {name} were removed; those keys now do nothing.",
    "noteRemovedPassThrough": "{count} characters of {name} were removed; those keys now type what the computer's own layout gives.",
    "noteRationale": "{text}"
  }
