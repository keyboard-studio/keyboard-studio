c Spec 104 fixture — REDUCED from release/sil/sil_cameroon_qwerty (v6.1.2).
c Kept verbatim: the diablock store and the T_0300 / T_030D rule sets
c (guard + bare producer; T_030D also carries the SHIFT forms, one of the
c six marks in the source with shift variants). T_002E's bare rule stands
c in for the six bare-rule punctuation producers. All other rules, stores
c and layers of the source are omitted; no K_ key has a rule here, so K_
c keys ride the KeymanWeb US fallback (state 0 / SHIFT only).

store(&VERSION) '10.0'
store(&NAME) 'Cameroon QWERTY'
store(&COPYRIGHT) '© SIL Cameroon'
store(&KEYBOARDVERSION) '6.1.2'
store(&LAYOUTFILE) 'sil_cameroon_qwerty.keyman-touch-layout'
store(&TARGETS) 'any'

begin Unicode > use(main)

group(main) using keys

store(diablock) " 0123456789?!;:'-_=<©®>.,[]{}\|/@°#$%^&*()«»‹›‘“’”€¥£…†ʼꞌꞋ" U+0022

+ [T_002E] > U+002E

c Handle Touch Diacritics (ignoring on non-letters)
any(diablock) + [T_0300] > context
+ [T_0300] > U+0300
any(diablock) + [T_030D] > context
any(diablock) + [SHIFT T_030D] > context
+ [T_030D] > U+030D
+ [SHIFT T_030D] > U+030D
