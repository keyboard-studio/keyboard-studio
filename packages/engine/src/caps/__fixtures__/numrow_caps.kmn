c Spec 112 fixture. CAPS rules on K_1..K_0 type digits under Caps and symbols otherwise: removing or replacing CAPS rules would change behaviour, so the caps comparison must report differs (research R5/R6).

store(&VERSION) '14.0'
store(&NAME) 'numrow_caps'
store(&TARGETS) 'any'

begin Unicode > use(main)

group(main) using keys

+ [K_A] > 'a'
+ [SHIFT K_A] > 'A'
+ [K_B] > 'b'
+ [SHIFT K_B] > 'B'
+ [K_C] > 'c'
+ [SHIFT K_C] > 'C'
+ [K_D] > 'd'
+ [SHIFT K_D] > 'D'
+ [K_E] > 'e'
+ [SHIFT K_E] > 'E'
+ [K_F] > 'f'
+ [SHIFT K_F] > 'F'
+ [K_G] > 'g'
+ [SHIFT K_G] > 'G'
+ [K_H] > 'h'
+ [SHIFT K_H] > 'H'
+ [K_I] > 'i'
+ [SHIFT K_I] > 'I'
+ [K_J] > 'j'
+ [SHIFT K_J] > 'J'
+ [K_K] > 'k'
+ [SHIFT K_K] > 'K'
+ [K_L] > 'l'
+ [SHIFT K_L] > 'L'
+ [K_M] > 'm'
+ [SHIFT K_M] > 'M'
+ [K_N] > 'n'
+ [SHIFT K_N] > 'N'
+ [K_O] > 'o'
+ [SHIFT K_O] > 'O'
+ [K_P] > 'p'
+ [SHIFT K_P] > 'P'
+ [K_Q] > 'q'
+ [SHIFT K_Q] > 'Q'
+ [K_R] > 'r'
+ [SHIFT K_R] > 'R'
+ [K_S] > 's'
+ [SHIFT K_S] > 'S'
+ [K_T] > 't'
+ [SHIFT K_T] > 'T'
+ [K_U] > 'u'
+ [SHIFT K_U] > 'U'
+ [K_V] > 'v'
+ [SHIFT K_V] > 'V'
+ [K_W] > 'w'
+ [SHIFT K_W] > 'W'
+ [K_X] > 'x'
+ [SHIFT K_X] > 'X'
+ [K_Y] > 'y'
+ [SHIFT K_Y] > 'Y'
+ [K_Z] > 'z'
+ [SHIFT K_Z] > 'Z'
+ [NCAPS K_1] > '1'
+ [NCAPS SHIFT K_1] > '!'
+ [CAPS K_1] > '1'
+ [CAPS SHIFT K_1] > '1'
+ [NCAPS K_2] > '2'
+ [NCAPS SHIFT K_2] > '@'
+ [CAPS K_2] > '2'
+ [CAPS SHIFT K_2] > '2'
+ [NCAPS K_3] > '3'
+ [NCAPS SHIFT K_3] > '#'
+ [CAPS K_3] > '3'
+ [CAPS SHIFT K_3] > '3'
+ [NCAPS K_4] > '4'
+ [NCAPS SHIFT K_4] > '$'
+ [CAPS K_4] > '4'
+ [CAPS SHIFT K_4] > '4'
+ [NCAPS K_5] > '5'
+ [NCAPS SHIFT K_5] > '%'
+ [CAPS K_5] > '5'
+ [CAPS SHIFT K_5] > '5'
+ [NCAPS K_6] > '6'
+ [NCAPS SHIFT K_6] > '^'
+ [CAPS K_6] > '6'
+ [CAPS SHIFT K_6] > '6'
+ [NCAPS K_7] > '7'
+ [NCAPS SHIFT K_7] > '&'
+ [CAPS K_7] > '7'
+ [CAPS SHIFT K_7] > '7'
+ [NCAPS K_8] > '8'
+ [NCAPS SHIFT K_8] > '*'
+ [CAPS K_8] > '8'
+ [CAPS SHIFT K_8] > '8'
+ [NCAPS K_9] > '9'
+ [NCAPS SHIFT K_9] > '('
+ [CAPS K_9] > '9'
+ [CAPS SHIFT K_9] > '9'
+ [NCAPS K_0] > '0'
+ [NCAPS SHIFT K_0] > ')'
+ [CAPS K_0] > '0'
+ [CAPS SHIFT K_0] > '0'
