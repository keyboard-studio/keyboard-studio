c Spec 112 fixture. Turkish dotted/dotless pairs: i/İ and ı/I are case pairs only under the Turkish counterpart table (research R3, caseCounterpart with bcp47 tr).

store(&VERSION) '14.0'
store(&NAME) 'turkish'
store(&TARGETS) 'any'
store(&BCP47) 'tr'

begin Unicode > use(main)

group(main) using keys

+ [K_A] > 'a'
+ [SHIFT K_A] > 'A'
+ [K_B] > 'b'
+ [SHIFT K_B] > 'B'
+ [K_C] > 'c'
+ [SHIFT K_C] > 'C'
+ [K_D] > 'd'
+ [SHIFT K_D] > 'D'
+ [K_E] > 'e'
+ [SHIFT K_E] > 'E'
+ [K_F] > 'f'
+ [SHIFT K_F] > 'F'
+ [K_G] > 'g'
+ [SHIFT K_G] > 'G'
+ [K_J] > 'j'
+ [SHIFT K_J] > 'J'
+ [K_K] > 'k'
+ [SHIFT K_K] > 'K'
+ [K_L] > 'l'
+ [SHIFT K_L] > 'L'
+ [K_M] > 'm'
+ [SHIFT K_M] > 'M'
+ [K_N] > 'n'
+ [SHIFT K_N] > 'N'
+ [K_O] > 'o'
+ [SHIFT K_O] > 'O'
+ [K_P] > 'p'
+ [SHIFT K_P] > 'P'
+ [K_Q] > 'q'
+ [SHIFT K_Q] > 'Q'
+ [K_R] > 'r'
+ [SHIFT K_R] > 'R'
+ [K_S] > 's'
+ [SHIFT K_S] > 'S'
+ [K_T] > 't'
+ [SHIFT K_T] > 'T'
+ [K_U] > 'u'
+ [SHIFT K_U] > 'U'
+ [K_V] > 'v'
+ [SHIFT K_V] > 'V'
+ [K_W] > 'w'
+ [SHIFT K_W] > 'W'
+ [K_X] > 'x'
+ [SHIFT K_X] > 'X'
+ [K_Y] > 'y'
+ [SHIFT K_Y] > 'Y'
+ [K_Z] > 'z'
+ [SHIFT K_Z] > 'Z'
+ [K_I] > 'i'
+ [SHIFT K_I] > 'İ'
+ [K_H] > 'ı'
+ [SHIFT K_H] > 'I'
