      "demoPairs": [
        {
          "expectedOutput": "5",
          "input": "Type `5`, then press the grave-accent key (K_QUOTE)",
          "note": "The combining grave (U+0300) is swallowed after a digit: any(diablock) + [K_QUOTE] > context re-emits the preceding `5`."
        },
        {
          "expectedOutput": "à",
          "input": "Type `a`, then press the grave-accent key (K_QUOTE)",
          "note": "After a letter the mark is NOT blocked — the blocking rules only fire when the preceding character is in the diablock set."
        }
