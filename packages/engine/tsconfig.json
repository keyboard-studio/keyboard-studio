{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "experimentalDecorators": true
  },
  "references": [
    { "path": "../contracts" }
  ],
  "include": ["src/**/*", "src/character-discovery/generated/*.json"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
