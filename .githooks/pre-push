#!/bin/sh
# keyboard-studio pre-push guard: run `pnpm lint` before code leaves the machine.
# Installed into the git hooks dir by scripts/install-git-hooks.mjs (pnpm install).
# Docs-only pushes (*.md, *.txt, docs/, specs/, .specify/) skip the lint.
# Bypass once with `git push --no-verify`; CI stays the backstop.
# KS-PRE-PUSH-GUARD (marker: the installer only overwrites hooks that carry it)

zero=0000000000000000000000000000000000000000
cmd="${KS_PRE_PUSH_CMD:-pnpm lint}"
needs_lint=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
  else
    base="$remote_sha"
  fi
  # No usable base (new repo, force-push over history we lack): lint to be safe.
  if [ -z "$base" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    needs_lint=1
    break
  fi
  if git diff --name-only "$base" "$local_sha" | grep -qvE '\.(md|txt)$|^(docs|specs|\.specify)/'; then
    needs_lint=1
    break
  fi
done

[ "$needs_lint" = 0 ] && exit 0

echo "[INFO] pre-push: running '$cmd' (skip once with: git push --no-verify)"
if ! sh -c "$cmd"; then
  echo "[ERROR] pre-push: '$cmd' failed; push aborted"
  exit 1
fi
exit 0
