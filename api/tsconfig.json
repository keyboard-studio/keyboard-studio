{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "rootDir": "..",
    // Restated from tsconfig.base.json on purpose: Vercel's Node builder reads only
    // this file's own compilerOptions before resolving `extends`, and when `module`
    // or `target` is missing it forces module/moduleResolution NodeNext and
    // strict: false, which breaks narrowing and extensionless re-exports.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Vercel's builder type-checks each function resolving modules through the
    // symlinked path, not pnpm's realpath. Match it, so a transitive type dep that
    // pnpm doesn't hoist (e.g. @types/node's undici-types, which types global
    // fetch Request/Response) fails here instead of only in the Vercel log.
    "preserveSymlinks": true
  },
  "exclude": ["node_modules", "**/*.test.ts"],
  "extends": "../tsconfig.base.json",
  "include": ["./**/*.ts"]
}
