{
  // NOTE: `paths` is NOT merged across `extends` — a base's map is replaced
  // wholesale. This tool needs BOTH the shared contracts mappings (kept in
  // step with ../tsconfig.contracts-paths.json) and the engine simulator's
  // vendored-Keyman mappings (kept in step with
  // ../../packages/engine/tsconfig.json), so both sets are spelled out here
  // rather than inherited.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@keyboard-studio/contracts": ["../../packages/contracts/src/index.ts"],
      "@keymanapp/common-types": [
        "../../packages/engine/src/simulator/vendor/keyman/common/types/main.ts"
      ],
      "@keymanapp/keyman-version": [
        "../../packages/engine/src/simulator/vendor/stubs/keyman-version.ts"
      ],
      "keyman/engine/keyboard": [
        "../../packages/engine/src/simulator/vendor/keyman/engine/keyboard/index.ts"
      ],
      "keyman/engine/keyboard/*": [
        "../../packages/engine/src/simulator/vendor/keyman/engine/keyboard/*"
      ],
      "keyman/engine/js-processor": [
        "../../packages/engine/src/simulator/vendor/keyman/engine/js-processor/index.ts"
      ],
      "keyman/engine/js-processor/*": [
        "../../packages/engine/src/simulator/vendor/keyman/engine/js-processor/*"
      ],
      "keyman/common/web-utils": [
        "../../packages/engine/src/simulator/vendor/keyman/common/web-utils/index.ts"
      ],
      "keyman/common/web-utils/*": [
        "../../packages/engine/src/simulator/vendor/keyman/common/web-utils/*"
      ]
    }
  }
}
